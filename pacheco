<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Music & Culture Flashcards</title>
    <style>
        /* Importando uma fonte com estilo rústico/country */
        @import url('https://googleapis.com');

        :root {
            --wood-dark: #3E2723;
            --leather: #8D6E63;
            --tan: #D7CCC8;
            --denim: #283593;
            --sunset-orange: #D84315;
            --cream: #FAF8F5;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--cream);
            background-image: radial-gradient(var(--tan) 1px, transparent 0);
            background-size: 24px 24px;
            color: var(--wood-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            margin-top: 20px;
        }

        header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            color: var(--wood-dark);
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px var(--tan);
        }

        header p {
            font-style: italic;
            color: var(--leather);
            font-size: 1.1rem;
        }

        /* Container do Flashcard */
        .card-container {
            width: 450px;
            height: 300px;
            perspective: 1000px;
            cursor: pointer;
            margin-bottom: 30px;
        }

        .card {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(62, 39, 35, 0.2);
            border-radius: 15px;
        }

        /* Classe que faz o card girar */
        .card.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px;
            text-align: center;
            border: 4px solid var(--wood-dark);
        }

        /* Lado da Frente (Pergunta/Conceito) */
        .card-front {
            background-color: #FFF;
            color: var(--wood-dark);
        }

        .card-front .category {
            position: absolute;
            top: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            background-color: var(--denim);
            color: #fff;
            padding: 4px 12px;
            border-radius: 20px;
        }

        .card-front h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .hint {
            font-size: 0.9rem;
            color: var(--leather);
            margin-top: 15px;
        }

        /* Lado de Trás (Resposta/Explicação) */
        .card-back {
            background-color: var(--wood-dark);
            color: var(--cream);
            transform: rotateY(180deg);
            border-color: var(--leather);
        }

        .card-back p {
            font-size: 1.2rem;
            line-height: 1.6;
        }

        /* Controles de Navegação */
        .controls {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-bottom: 20px;
        }

        button {
            background-color: var(--leather);
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        button:hover {
            background-color: var(--wood-dark);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        .progress {
            font-size: 1rem;
            font-weight: 600;
            color: var(--leather);
        }

        /* Responsividade para telas menores */
        @media (max-width: 500px) {
            .card-container {
                width: 90vw;
                height: 280px;
            }
            header h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>🤠 Country Legends & Culture 🎸</h1>
        <p>Clique no cartão para revelar a resposta</p>
    </header>

    <!-- Estrutura do Flashcard -->
    <div class="card-container" onclick="flipCard()">
        <div class="card" id="flashcard">
            <!-- Frente -->
            <div class="card-face card-front">
                <span class="category" id="card-category">Categoria</span>
                <h2 id="card-question">Pergunta do Card</h2>
                <p class="hint">💡 Toque para ver a resposta</p>
            </div>
            <!-- Verso -->
            <div class="card-face card-back">
                <p id="card-answer">Resposta do Card.</p>
            </div>
        </div>
    </div>

    <!-- Navegação -->
    <div class="controls">
        <button onclick="prevCard()">◄ Voltar</button>
        <span class="progress" id="card-progress">1 / 5</span>
        <button onclick="nextCard()">Avançar ►</button>
    </div>

    <script>
        // Banco de dados dos flashcards com o tema Country
        const flashcards = [
            {
                category: "Lendas da Música",
                question: "Quem é conhecido como 'The Man in Black'?",
                answer: "Johnny Cash. Ele ganhou esse apelido por se vestir quase sempre inteiramente de preto em seus shows, como uma forma de protesto social."
            },
            {
                category: "Cultura",
                question: "O que é o 'Grand Ole Opry'?",
                answer: "O show de rádio de música country mais antigo do mundo, transmitido semanalmente de Nashville, Tennessee, desde 1925."
            },
            {
                category: "Instrumentos",
                question: "Qual instrumento de cordas com corpo circular e pele esticada é essencial no Bluegrass?",
                answer: "O Banjo. Ele traz o ritmo rápido e o som estalado característico das vertentes tradicionais do country."
            },
            {
                category: "Rainhas do Country",
                question: "Quem é a cantora compositora do hino 'I Will Always Love You' e dona do parque Dollywood?",
                answer: "Dolly Parton. Além de escrever a música (famosa também na voz de Whitney Houston), ela é um dos maiores ícones da cultura pop e country americana."
            },
            {
                category: "Geografia",
                question: "Qual cidade americana é mundialmente famosa como a 'Capital da Música Country'?",
                answer: "Nashville, no estado do Tennessee. É o coração da indústria musical country e lar da Music Row."
            }
        ];

        let currentIndex = 0;
        const cardElement = document.getElementById('flashcard');
        const categoryElement = document.getElementById('card-category');
        const questionElement = document.getElementById('card-question');
        const answerElement = document.getElementById('card-answer');
        const progressElement = document.getElementById('card-progress');

        // Função para atualizar os dados visíveis do card
        function updateCard() {
            // Garante que o card volte para a frente antes de mudar o texto
            cardElement.classList.remove('flipped');
            
            // Pequeno atraso para trocar o texto enquanto o card desvira
            setTimeout(() => {
                const currentData = flashcards[currentIndex];
                categoryElement.textContent = currentData.category;
                questionElement.textContent = currentData.question;
                answerElement.textContent = currentData.answer;
                progressElement.textContent = `${currentIndex + 1} / ${flashcards.length}`;
            }, 150);
        }

        // Função para girar o card
        function flipCard() {
            cardElement.classList.toggle('flipped');
        }

        // Avançar para o próximo card
        function nextCard() {
            // Evita propagação do clique para não girar o card ao clicar no botão
            event.stopPropagation(); 
            currentIndex = (currentIndex + 1) % flashcards.length;
            updateCard();
        }

        // Voltar para o card anterior
        function prevCard() {
            event.stopPropagation();
            currentIndex = (currentIndex - 1 + flashcards.length) % flashcards.length;
            updateCard();
        }

        // Inicializa o primeiro card na tela
        updateCard();
    </script>
</body>
</html>
